# ── GLOCEL Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to Git!

# Supabase PostgreSQL connection string (get from Supabase → Settings → Database → URI)
# Add ?sslmode=require at the end if not already present.
DATABASE_URL=postgresql://postgres.YOURPROJECT:YOURPASSWORD@aws-0-YOURREGION.pooler.supabase.com:6543/postgres?sslmode=require

# A long random string for Flask session security.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# First admin account, created automatically on startup if no users exist yet.
# (If you leave these blank, the first visit to the site shows a one-time setup page instead.)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Flask environment (development or production)
FLASK_ENV=development
